#!/bin/sh
# Antes de subir a main, la suite entera (28/10/2026). GitHub Pages publica la
# app con CADA push a main, sin mirar nada: v244 salio con esta suite en rojo.
# Se activa una vez por clon con:  git config core.hooksPath .githooks
# (test/test-hook.js avisa si en este clon no esta activo).
# Pide el repo ga-portfolio-worker al lado (o GA_WORKER): test-html cruza el
# MAP de la PWA contra API_FNS.
sube_main=0
while read local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] && sube_main=1
done
[ "$sube_main" = 1 ] || exit 0

echo "pre-push: npm test antes de publicar en main (~1 min)..."
if ! npm test > .githooks/ultima-corrida.log 2>&1; then
  grep -E "FALLA|Error|fallas" .githooks/ultima-corrida.log | head -20
  echo ""
  echo "pre-push: la suite esta en ROJO, no se sube (GitHub Pages la publicaria). Detalle: .githooks/ultima-corrida.log"
  exit 1
fi
tail -1 .githooks/ultima-corrida.log
